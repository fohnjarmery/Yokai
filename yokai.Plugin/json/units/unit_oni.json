{
  "$schema": "https://raw.githubusercontent.com/Monster-Train-2-Modding-Group/Trainworks-Reloaded/refs/heads/main/schemas/base.json",
  "cards": [
    {
      "id": "SpawnOni",
      "names": {
        "english": "Oni"
      },
      "card_art": "@Oni",
      "cost": 2,
      "card_type": "monster",
      "rarity": "uncommon",
      "class": "@ClassYokai",
      "targets_room": true,
      "effects": [
        {
          "id": "@SpawnOni"
        }
      ],
      "lore_tooltips": [
        {
          "english": "Flavour Text"
        }
      ],
      "pools": [
        "UnitsAllBanner"
      ]
    }
  ],
  "characters": [
    {
      "id": "Oni",
      "size": 2,
      "attack_damage": 25,
      "health": 45,
      "names": {
        "english": "Oni"
      },
      "character_art": "@OniCharacterArt",
      "subtypes": [
        "SubtypesData_BannerUnit",
        "@Sub_Demon"
      ],
      "triggers": [
        {
          "id": "@OniStrikeTrigger"
        },
        {
          "id": "@OniRevengeTrigger"
        }
      ]
    }
  ],
  "character_triggers": [
    {
      "id": "OniStrikeTrigger",
      "descriptions": {
        "english": "<b>Retreat</b> the attacked unit."
      },
      "trigger": "on_attacking",
      "effects": [
        {
          "id": "@OniPushback"
        }
      ]
    },
    {
      "id": "OniRevengeTrigger",
      "descriptions": {
        "english": "Gain [yokai.Plugin_haunt] [effect0.status0.power]."
      },
      "trigger": "on_hit",
      "effects": [
        {
          "id": "@OniGainHaunt"
        }
      ]
    }
  ],
  "effects": [
    {
      "id": "SpawnOni",
      "name": "CardEffectSpawnMonster",
      "target_mode": "room",
      "param_character": "@Oni"
    },
    {
      "id": "OniPushback",
      "name": "CardEffectFloorRearrange",
      "target_mode": "last_attacked_character",
      "target_team": "heroes",
      "param_int": 1
    },
    {
      "id": "OniGainHaunt",
      "name": "CardEffectAddStatusEffect",
      "target_mode": "self",
      "target_team": "monsters",
      "param_status_effects": [
        {
          "status": "@haunt",
          "count": 1
        }
      ]
    }

  ],
  "sprites": [
    {
      "id": "Oni",
      "path": "textures/OniCardArt.png"
    },
    {
      "id": "OniCharacterArt",
      "path": "textures/OniCharacterArt.png"
    }
  ],
  "game_objects": [
    {
      "id": "Oni",
      "type": "card_art",
      "extensions": {
        "card_art": {
          "sprite": "@Oni"
        }
      }
    },
    {
      "id": "OniCharacterArt",
      "type": "character_art",
      "extensions": {
        "character_art": {
          "sprite": "@OniCharacterArt",
          "transform": {
            "position": {
              "x": 0.1,
              "y": 0.73,
              "z": 0
            },
            "scale": {
              "x": 0.9,
              "y": 0.9,
              "z": 1
            }
          }
        }
      }
    }
  ]
}